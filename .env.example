# Copy into Laravel host app root as .env, or use /assist/setup wizard.

APP_NAME=Assist
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=assist
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Assist integration
ASSIST_APP_KEY=change-me-to-a-long-random-string
ASSIST_DEFAULT_PLAN=free
ASSIST_UPGRADE_URL=https://yourdomain.com/pricing
ASSIST_DOWNLOAD_URL=#download
# Shown on the site when only the Apple Silicon Mac build is published
ASSIST_MAC_AVAILABILITY_NOTICE="Currently available for Apple Silicon Mac (arm64). Intel Mac, Windows, and Linux builds appear here when uploaded."
ASSIST_SUPPORT_EMAIL=support@yourdomain.com
ASSIST_SETUP_ENABLED=true

# Payment: comma-separated enabled gateways + default when customer does not choose
PAYMENT_GATEWAYS_ENABLED=checkoutpay,paystack
PAYMENT_GATEWAY=checkoutpay

# CheckoutPay (https://check-outpay.com/api/v1)
CHECKOUT_BASE_URL=https://check-outpay.com/api/v1
CHECKOUT_API_KEY=
CHECKOUT_WEBHOOK_URL=https://yourdomain.com/webhooks/checkoutpay
CHECKOUT_DEV_PROGRAM_PARTNER_ID=

# Paystack (https://paystack.com)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_URL=https://yourdomain.com/webhooks/paystack
